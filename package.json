{
  "name": "mister-companion-ex",
  "version": "0.4.53-alpha.0",
  "description": "MiSTer Companion EX Electron UI using the MiSTer Companion Python core backend.",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "start": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "format:css": "node scripts/format-css.cjs",
    "lint": "eslint src electron scripts vite.config.js",
    "test:js": "vitest run --config vitest.config.mjs --configLoader runner",
    "test:python": "python -m unittest discover -s python-backend/tests -p \"test_*.py\"",
    "test": "npm run test:js && npm run test:python",
    "check:lockfile": "node scripts/check-package-lock-registry.cjs",
    "check": "npm run check:lockfile && npm run lint && npm run test && npm run build",
    "release:verify": "node scripts/verify-release-version.cjs",
    "build": "node node_modules/vite/bin/vite.js build --configLoader runner",
    "dist": "node node_modules/vite/bin/vite.js build --configLoader runner && electron-builder --win portable --x64",
    "dist:signed": "node node_modules/vite/bin/vite.js build --configLoader runner && electron-builder --win portable --x64 --config.forceCodeSigning=true"
  },
  "dependencies": {
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "build": {
    "appId": "com.arcanthur.mistercompanion.vaultkit",
    "productName": "MiSTer Companion EX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/**/*",
      "!**/__pycache__/**",
      "!**/*.pyc"
    ],
    "extraResources": [
      {
        "from": "python-backend",
        "to": "python-backend"
      },
      {
        "from": "src/assets/mister",
        "to": "default-theme-assets"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "MiSTer-Companion-EX-${version}-Windows.${ext}",
      "icon": "build/mister-companion.png"
    },
    "artifactName": "MiSTer-Companion-EX-${version}-Windows.${ext}"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  },
  "author": "Arcanthur / MiSTer Companion core by Anime0t4ku"
}
